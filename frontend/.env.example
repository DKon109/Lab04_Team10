# Likes/recommendations integration mode:
#   api   - use the backend endpoints (POST/DELETE /api/events/{id}/like,
#           GET /api/users/me/liked-events, GET /api/events/for-you)
#   local - TEMPORARY frontend-only mode that stores likes in localStorage and
#           ranks "For You" in the browser. Use this if you are running an
#           older backend build without the like endpoints.
VITE_LIKES_MODE=api
